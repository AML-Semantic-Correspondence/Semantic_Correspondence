        "if CONFIGURATION[\"DEVICE\"] == \"cuda\":\n",
        "    torch.cuda.synchronize()          # STOP\n",
        "    end_event.record()\n",
        "else:\n",
        "    end_event = time.time()\n",
        "\n",
        "\n",
        "elapsed_time = start_event.elapsed_time(end_event) / 1000              # SECONDS\n",
